<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless.NUnit" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.5.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.182" />
    <PackageVersion Include="Sbom" Version="0.3.1" />
    <PackageVersion Include="Verify" Version="33.3.0" />
    <PackageVersion Include="Verify.CommunityToolkit.Mvvm" Version="1.1.0" />
    <PackageVersion Include="Verify.NUnit" Version="33.3.0" />
    <!-- Avalonia.Headless.XUnit 12.1.x is built against xunit.v3 3.2.x and fails discovery under 4.x.
         Verify.XunitV3 32.0.1 is the last release on xunit.v3 3.x. Bump both once Avalonia supports xunit 4. -->
    <PackageVersion Include="Verify.XunitV3" Version="33.3.0" Pinned="true" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" Pinned="true" />
    <PackageVersion Include="Argon" Version="0.38.0" />
    <PackageVersion Include="DiffEngine" Version="20.7.0" />
    <PackageVersion Include="EmptyFiles" Version="8.20.0" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.0" />
  </ItemGroup>
</Project>
